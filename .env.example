# Anthropic API key — used server-side only in /api/evaluate
ANTHROPIC_API_KEY=

# Password for the /admin page
ADMIN_PASSWORD=

# Upstash Redis (created automatically by the Vercel Marketplace integration;
# either naming scheme works)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob storage for candidate videos (created via Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Optional: webhook that receives a JSON notification about each finished
# assessment (candidate name, band, result URL, video URLs) — for the
# talent-flow candidate database integration.
TALENT_FLOW_WEBHOOK_URL=
TALENT_FLOW_API_KEY=
